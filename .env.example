# ==============================================================================
# ভাগ্য উন্নয়ন সমাজ কল্যাণ সংস্থা - Environment Variables Configuration
# ==============================================================================

# Client-Side Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-Side Firebase Admin Configuration (Private - Do NOT expose to client)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: For private key with newlines, keep quotes or replace \n with actual newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Initial CEO / Admin Setup Credentials (For one-time secure bootstrapping)
INITIAL_CEO_EMAIL=ceo@bhaggounnayan.org
INITIAL_CEO_PASSWORD=ChangeThisSecurePassword2026!
INITIAL_CEO_NAME="মোঃ রফিকুল ইসলাম"
INITIAL_CEO_PHONE="+8801712345678"
ADMIN_SETUP_TOKEN=your-high-entropy-secure-bootstrap-token-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
